diff --git a/tests/test_team_user_disable.py b/tests/test_team_user_disable.py
new file mode 100644
index 0000000..878ffc6
--- /dev/null
+++ b/tests/test_team_user_disable.py
@@ -0,0 +1,43 @@
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from team_memory.contracts import Forbidden, Unauthorized
+from team_memory.registry import Registry
+
+
+@pytest.fixture
+def registry(tmp_path):
+    result = Registry(tmp_path)
+    result.add_user('anna', 'Anna')
+    result.add_team('finance', 'Finance')
+    result.membership('anna', 'finance', 'editor')
+    return result
+
+
+def test_disable_user_revokes_every_token_without_token_files(registry):
+    first = registry.issue_token('anna', 'codex')
+    second = registry.issue_token('anna', 'cursor')
+    assert registry.disable_user('anna') == 2
+    for token in (first, second):
+        with pytest.raises(Unauthorized):
+            registry.authenticate(token)
+    with pytest.raises(Forbidden):
+        registry.issue_token('anna', 'reissue')
+    with pytest.raises(Forbidden):
+        registry.disable_user('nobody')
+    with registry.connect() as db:
+        assert db.execute("SELECT COUNT(*) FROM admin_events WHERE action='user_disabled' AND subject='anna'").fetchone()[0] == 1
+
+
+def test_user_disable_cli(registry, tmp_path):
+    token = registry.issue_token('anna', 'codex')
+    root = Path(__file__).resolve().parents[1]
+    env = {**os.environ, 'PYTHONPATH': str(root / 'src')}
+    subprocess.run([sys.executable, '-m', 'team_memory.cli', '--root', str(registry.root), 'user-disable', 'anna'],
+                   env=env, check=True, capture_output=True, timeout=60)
+    with pytest.raises(Unauthorized):
+        registry.authenticate(token)
