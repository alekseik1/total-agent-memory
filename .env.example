# total-agent-memory — example environment configuration
#
# Copy to .env and edit. All values shown are defaults; uncommenting them
# is harmless. The full reference is in README.md > Configuration.

# -----------------------------------------------------------------------------
# v11.0 — Memory Mode (fast = production default, zero LLM in hot path)
# -----------------------------------------------------------------------------

MEMORY_MODE=fast
MEMORY_USE_LLM_IN_HOT_PATH=false
MEMORY_ALLOW_OLLAMA_IN_HOT_PATH=false
MEMORY_RERANK_ENABLED=false
MEMORY_ENRICHMENT_ENABLED=false
MEMORY_FACT_MERGE_ENABLED=false

# Per-space embedding models (empty -> fall back to TEXT model, but
# the row still records its space -- future model swap is config-only)
MEMORY_TEXT_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_CODE_EMBED_MODEL=
MEMORY_LOG_EMBED_MODEL=
MEMORY_CONFIG_EMBED_MODEL=
MEMORY_DEFAULT_EMBEDDING_SPACE=text

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# MEMORY_DB=~/.claude-memory/memory.db
# DASHBOARD_PORT=37737
# Extra host names for the dashboard's Host check (loopback always allowed):
# DASHBOARD_ALLOWED_HOSTS=memory.lan
# MEMORY_MCP_PORT=3737
# Extra host names for the MCP HTTP transport's Host check (loopback always allowed):
# MCP_HTTP_ALLOWED_HOSTS=memory.lan

# -----------------------------------------------------------------------------
# self_rules_context
# -----------------------------------------------------------------------------

# MEMORY_RULES_LIMIT=            # cap on rules returned by self_rules_context (default: no cap)

# -----------------------------------------------------------------------------
# v10.5 -- LLM enrichment (only consulted when MEMORY_USE_LLM_IN_HOT_PATH=true
# or async worker is enabled via MEMORY_ENRICHMENT_ENABLED=true)
# -----------------------------------------------------------------------------

# MEMORY_LLM_ENABLED=auto
# MEMORY_LLM_MODEL=qwen2.5-coder:7b
# OLLAMA_URL=http://localhost:11434
# MEMORY_LLM_TIMEOUT_SEC=60
# MEMORY_TRIPLE_TIMEOUT_SEC=30
# MEMORY_ENRICH_TIMEOUT_SEC=45
# MEMORY_REPR_TIMEOUT_SEC=60

# -----------------------------------------------------------------------------
# v10.1 -- async enrichment worker (auto-enabled in balanced/deep modes)
# -----------------------------------------------------------------------------

# MEMORY_ASYNC_ENRICHMENT=true        # set automatically by MEMORY_MODE
# MEMORY_ENRICH_TICK_SEC=0.1
# MEMORY_ENRICH_BATCH=5
# MEMORY_ENRICH_MAX_ATTEMPTS=3
# MEMORY_ENRICH_STALE_AFTER_SEC=60

# -----------------------------------------------------------------------------
# Cloud LLM provider (optional -- replaces local Ollama in deep mode)
# -----------------------------------------------------------------------------

# MEMORY_LLM_PROVIDER=openai          # openai | openai-compatible | anthropic | ollama
MEMORY_EMBED_THREADS=1
# Applied before PyTorch import; overrides inherited OMP/OPENBLAS thread counts.
MEMORY_TORCH_THREADS=1
MEMORY_VISION_MODEL=

# Isolated multi-user server (docker-compose.team.yml).
TAM_TEAM_MAX_WORKERS=3
TAM_TEAM_OPERATION_TIMEOUT=120
TAM_TEAM_PORT=3738
TAM_TEAM_PUBLISH_HOST=127.0.0.1
# Team dashboard (docs/TEAM_DASHBOARD.md). Empty master key = generate <team-data>/master.key (0600).
TAM_TEAM_MASTER_KEY=
# auto = Secure cookie when the request is HTTPS; set true only behind your own reverse proxy.
TAM_TEAM_COOKIE_SECURE=auto
TAM_TEAM_TRUST_PROXY=false
# External PostgreSQL instead of SQLite (docs/TEAM_POSTGRES.md). Empty = SQLite. A DSN saved in the
# dashboard wins over this one. Only postgresql:// URIs; percent-encode special characters.
TAM_TEAM_DATABASE_URL=
TAM_TEAM_PG_STATEMENT_TIMEOUT_MS=30000
TAM_TEAM_PG_WORKSPACE_CONNECTION_LIMIT=4
TAM_TEAM_PG_POOL_MAX_SIZE=8
# docker-compose.team.postgres.yml only (local evaluation database, not for production).
TAM_TEAM_PG_PASSWORD=
TAM_POSTGRES_SUPERUSER_PASSWORD=
# Continuous backup with Litestream (docs/TEAM_BACKUP.md): empty URL = off; SQLite backend only.
# Start the sidecar with `--profile litestream`; add `--profile s3-local` for a local test bucket.
TAM_TEAM_REPLICA_URL=
TAM_TEAM_REPLICA_ENDPOINT=
TAM_TEAM_REPLICA_REGION=us-east-1
TAM_TEAM_REPLICA_FORCE_PATH_STYLE=false
TAM_TEAM_REPLICA_SYNC_INTERVAL=1s
TAM_TEAM_REPLICA_SNAPSHOT_INTERVAL=24h
TAM_TEAM_REPLICA_RETENTION=168h
TAM_TEAM_REPLICA_METRICS_ADDR=
# Bucket credentials, read only by Litestream and `tam-team replication`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# openai-compatible requires explicit MEMORY_LLM_API_BASE and MEMORY_LLM_MODEL.
# MEMORY_LLM_API_KEY is optional for a local endpoint; cloud keys are not inherited.
# MEMORY_LLM_API_KEY=
# MEMORY_LLM_API_BASE=                # e.g. https://openrouter.ai/api/v1
# MEMORY_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Cloud embedding provider (optional -- requires re-embed on dimension change)
# -----------------------------------------------------------------------------

# MEMORY_EMBED_PROVIDER=fastembed     # fastembed | sentence-transformers | ollama | openai | cohere
# MEMORY_EMBED_API_KEY=
# MEMORY_EMBED_MODEL=                 # e.g. text-embedding-3-small (1536d)

# Source-grounded fact indexing runs only in the background enrichment worker.
MEMORY_ATOMIC_FACTS_ENABLED=false
MEMORY_BOUNDED_RERANK=false
MEMORY_RERANK_DEADLINE_MS=250
MEMORY_RERANK_CANDIDATES=20
MEMORY_RERANK_STARTUP_SECONDS=60
# Local directory or already cached model; request-time downloads are disabled.
MEMORY_RERANK_LOCAL_MODEL=
MEMORY_VECTOR_CACHE_BYTES=67108864
MEMORY_VECTOR_EXACT_LIMIT=32768
# Enable MEMORY_ASYNC_ENRICHMENT=true and configure the enrich LLM phase to generate facts.
MEMORY_PASSAGE_INDEX_ENABLED=false
MEMORY_REASON_PROVIDER=auto
MEMORY_REASON_MODEL=
# Docker host alias for a model server running on Linux/macOS/Windows host.
TAM_TEAM_HOST_GATEWAY=host.docker.internal:host-gateway
